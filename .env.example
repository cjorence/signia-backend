APP_NAME=Signia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Private recognition service; set an identical random 32+ character token in Python for production.
RECOGNITION_SERVICE_URL=http://127.0.0.1:5000
FSL_SERVICE_TOKEN=
# Local development only. Explicitly choose true/false in BOTH hosted services.
# Production defaults to false when absent. Drain jobs before restarting Python.
FSL_TRAINING_ENABLED=true
APP_URL=http://localhost:8000

# Security & CORS Settings
# Only the exact ingress proxy IP; leave empty for direct local requests.
TRUSTED_PROXIES=
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
# Production on persistent disk: LOG_STACK=daily, LOG_LEVEL=warning.
# Containers: use LOG_CHANNEL=stderr and configure host log collection/retention.
LOG_DAILY_DAYS=14

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=signia_db
DB_USERNAME=root
DB_PASSWORD=

# Session & Security (Leave SESSION_DOMAIN empty for local development)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
# Railway Hobby uses HTTPS email: set MAIL_MAILER=resend and a verified sender.
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# PayMongo (use test credentials for local development)
PAYMONGO_SECRET_KEY=
PAYMONGO_API_URL=https://api.paymongo.com
PAYMONGO_MODE=test
PAYMONGO_WEBHOOK_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/login

# Cloudflare Turnstile
CLOUDFLARE_TURNSTILE_SECRET_KEY=
